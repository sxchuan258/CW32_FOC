".\output\exe\cw32l010_btim.o"
".\output\exe\cw32l010_crc.o"
".\output\exe\cw32l010_flash.o"
".\output\exe\cw32l010_gpio.o"
".\output\exe\cw32l010_gtim.o"
".\output\exe\cw32l010_pwr.o"
